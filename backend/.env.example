# Tethr Backend Environment Variables
ENVIRONMENT=development
DEBUG=True

# MongoDB Atlas Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=tethr_dev

# Clerk Authentication (RS256 JWT via JWKS)
# Replace with your actual Clerk instance URL, e.g. https://clerk.your-domain.dev or https://your-app.clerk.accounts.dev
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Development/Testing Authentication Bypass (set to True for offline local dev without live Clerk keys)
DEV_MOCK_AUTH=True

# AES-256-GCM 32-byte Base64 key for encrypting Google OAuth refresh tokens at rest
# Generated via: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here

# Logging Configuration (Loguru)
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
LOG_ROTATION=20 MB

# Allowed CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
